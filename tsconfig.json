{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "app.tsx",
    "shared.ts",
    "store.ts",
    "eval.ts",
    "eval.test.ts",
    "eval-run.test.ts",
    "components",
    "lib",
    "hooks",
    "*.test.ts"
  ]
}
